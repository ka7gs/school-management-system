rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all for any unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSchoolConfig(data) {
      return data.schoolName is string && data.schoolName.size() <= 150 &&
             data.directorate is string && data.directorate.size() <= 200 &&
             data.academicYear is string && data.academicYear.size() <= 50;
    }

    function isValidStudent(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.fullName is string && data.fullName.size() <= 150 &&
             data.ministryId is string && data.ministryId.size() <= 50 &&
             data.adminId is string && data.adminId.size() <= 50 &&
             data.stageCode in ['primary', 'intermediate', 'preparatory'] &&
             data.gradeCode is string && data.gradeCode.size() <= 20;
    }

    function isValidGradeRecord(data) {
      return data.studentName is string && data.studentName.size() <= 150 &&
             data.ministryId is string && data.ministryId.size() <= 50 &&
             data.stage in ['primary', 'intermediate', 'preparatory'] &&
             data.gradeCode is string && data.gradeCode.size() <= 20;
    }

    function isValidStaffMember(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.fullName is string && data.fullName.size() <= 150 &&
             data.roleTitle is string && data.roleTitle.size() <= 100;
    }

    function isValidWeeklySchedule(data) {
      return data.classId is string && data.classId.size() <= 64 &&
             data.classroom is string && data.classroom.size() <= 100 &&
             data.stage in ['primary', 'intermediate', 'preparatory'] &&
             data.gradeCode is string && data.gradeCode.size() <= 20;
    }

    function isValidUserAccount(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 150 &&
             data.role in ['principal', 'registrar', 'teacher', 'accountant'];
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.title is string && data.title.size() <= 150 &&
             data.message is string && data.message.size() <= 500;
    }

    // Schools Match Block
    match /schools/{schoolId} {
      allow get, list: if true;
      allow create, update: if isValidId(schoolId) && isValidSchoolConfig(incoming());
      allow delete: if false;

      // Students
      match /students/{studentId} {
        allow get, list: if true;
        allow create, update: if isValidId(studentId) && isValidStudent(incoming());
        allow delete: if isValidId(studentId);
      }

      // Grades
      match /grades/{gradeId} {
        allow get, list: if true;
        allow create, update: if isValidId(gradeId) && isValidGradeRecord(incoming());
        allow delete: if isValidId(gradeId);
      }

      // Multi-Subject Student Grades
      match /multiGrades/{recordId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(recordId);
      }

      // Staff
      match /staff/{staffId} {
        allow get, list: if true;
        allow create, update: if isValidId(staffId) && isValidStaffMember(incoming());
        allow delete: if isValidId(staffId);
      }

      // Schedules
      match /schedules/{scheduleId} {
        allow get, list: if true;
        allow create, update: if isValidId(scheduleId) && isValidWeeklySchedule(incoming());
        allow delete: if isValidId(scheduleId);
      }

      // User Accounts
      match /userAccounts/{userId} {
        allow get, list: if true;
        allow create, update: if isValidId(userId) && isValidUserAccount(incoming());
        allow delete: if isValidId(userId);
      }

      // Notifications
      match /notifications/{notificationId} {
        allow get, list: if true;
        allow create: if isValidId(notificationId) && isValidNotification(incoming());
        allow update: if isValidId(notificationId);
        allow delete: if isValidId(notificationId);
      }

      // Attendance
      match /attendance/{attendanceId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(attendanceId);
      }

      // Finance & Tuition Receipts
      match /financeReceipts/{receiptId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(receiptId);
      }
    }
  }
}
